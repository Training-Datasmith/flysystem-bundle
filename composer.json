{
    "name": "league/flysystem-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle integrating Flysystem into Symfony applications",
    "keywords": [
        "symfony",
        "flysystem",
        "filesystem",
        "bundle"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Titouan Galopin",
            "email": "galopintitouan@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "autoload": {
        "psr-4": {
            "League\\FlysystemBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\League\\FlysystemBundle\\": "tests"
        }
    },
    "require": {
        "php": ">=8.2",
        "league/flysystem": "^3.0",
        "symfony/config": "^6.0 || ^7.0 || ^8.0",
        "symfony/deprecation-contracts": "^2.1 || ^3",
        "symfony/http-kernel": "^6.0 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.0 || ^7.0 || ^8.0",
        "symfony/options-resolver": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "doctrine/mongodb-odm": "^2.0",
        "league/flysystem-async-aws-s3": "^3.1",
        "league/flysystem-aws-s3-v3": "dev-remote-test-2026-10-07 as 3.32.0",
        "league/flysystem-azure-blob-storage": "^3.1",
        "league/flysystem-ftp": "dev-remote-test-2026-10-07 as 3.31.0",
        "league/flysystem-google-cloud-storage": "dev-remote-test-2026-10-07 as 3.31.0",
        "league/flysystem-gridfs": "^3.28",
        "league/flysystem-local": "dev-remote-test-2026-10-07 as 3.31.0",
        "league/flysystem-memory": "dev-remote-test-2026-10-07 as 3.31.0",
        "league/flysystem-read-only": "dev-remote-test-2026-10-07 as 3.31.0",
        "league/flysystem-sftp-v3": "dev-remote-test-2026-10-07 as 3.31.0",
        "league/flysystem-webdav": "^3.29",
        "platformcommunity/flysystem-bunnycdn": "^3.3",
        "psr/http-client": "dev-remote-test-2026-10-07 as 1.0.3",
        "psr/http-factory": "dev-remote-test-2026-10-07 as 1.1.0",
        "psr/http-message": "dev-remote-test-2026-10-07 as 2.0.0",
        "symfony/dotenv": "^6.0 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.0 || ^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^6.0 || ^7.0 || ^8.0",
        "symfony/var-dumper": "^6.0 || ^7.0 || ^8.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
